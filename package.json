{
  "name": "formsafe",
  "version": "2.0.0",
  "private": true,
  "description": "Privacy-first Chrome extension for encrypted local form recovery.",
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "form-autosave",
    "form-recovery",
    "privacy-first",
    "local-first",
    "productivity",
    "manifest-v3",
    "wxt",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/MaryanKostrubyak/form-safe#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaryanKostrubyak/form-safe.git"
  },
  "bugs": {
    "url": "https://github.com/MaryanKostrubyak/form-safe/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "release:check": "corepack pnpm@9.15.4 typecheck && corepack pnpm@9.15.4 lint && corepack pnpm@9.15.4 test:coverage && corepack pnpm@9.15.4 build && corepack pnpm@9.15.4 test:e2e && corepack pnpm@9.15.4 zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": "0.6.0",
      "shell-quote": "1.8.4",
      "tmp": "0.2.7",
      "vite": "6.4.3"
    }
  }
}
