{
  "name": "formsafe",
  "version": "1.0.0",
  "private": true,
  "description": "Privacy-first Chrome extension that autosaves online form drafts locally.",
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "form-autosave",
    "form-recovery",
    "privacy-first",
    "local-first",
    "productivity",
    "manifest-v3",
    "wxt",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/MaryanKostrubyak/form-safe#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaryanKostrubyak/form-safe.git"
  },
  "bugs": {
    "url": "https://github.com/MaryanKostrubyak/form-safe/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "release:check": "npm run typecheck && npm run lint && npm run build && npm run zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/module-react": "1.1.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "wxt": "^0.19.23"
  }
}
